    {
      "name": "Create Threat - Constraint Violations (400)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ThreatBase defines no enums for severity/priority/status (free strings), so use constraints it does document:",
              "// severity maxLength 50 and threat_type uniqueItems",
              "const invalidThreat = {",
              "    name: 'Test Threat',",
              "    threat_type: ['Spoofing', 'Spoofing'],",
              "    severity: 'x'.repeat(51),",
              "    mitigated: false",
              "};",
              "",
              "pm.collectionVariables.set('invalidConstraintThreatData', JSON.stringify(invalidThreat));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error indicates constraint violation', function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData).to.have.property('error');",
              "    pm.expect(responseData.error).to.equal('invalid_input');",
              "    pm.expect(responseData.error_description).to.be.a('string').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{invalidConstraintThreatData}}"
        },
        "url": {
          "raw": "{{baseUrl}}/threat_models/{{aliceThreatModelId}}/threats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "threat_models",
            "{{aliceThreatModelId}}",
            "threats"
          ]
        },
        "description": "Test threat creation with values that violate documented ThreatBase constraints (severity maxLength 50, threat_type uniqueItems)"
      }
    },
