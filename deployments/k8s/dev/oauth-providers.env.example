# Template for .local/oauth-providers.env — the real OAuth/SAML provider config
# for a dev cluster (k3s or docker-desktop).
#
# WHAT THIS IS FOR
#
# Since the #415 three-category config split, OAuth providers, SAML providers,
# the callback/base URLs and the admin identity are all *operational* settings.
# The config.yml delivered to the pod is bootstrap-only and cannot carry them,
# and the database copy is destroyed by `make dev-nuke` (which deletes the
# tmi-platform namespace and with it the Postgres PVC). Without this file the
# server comes back advertising nothing but the built-in "tmi" provider — the
# "we keep losing all our configuration" failure in #791.
#
# scripts/lib/deploy.py reads this file on every `make dev-up` / `make
# dev-restart`, delivers it as Secret/tmi-oauth-providers, and server.yml pulls
# every key in as an environment variable via `envFrom`. That makes the config
# self-healing across a nuke.
#
# SETUP
#
#     cp deployments/k8s/dev/oauth-providers.env.example .local/oauth-providers.env
#     chmod 600 .local/oauth-providers.env
#     # fill in the real values, then:
#     make dev-restart CLUSTER=k3s
#
# .local/ is gitignored in full, so the filled-in file is never committed.
#
# FORMAT
#
# Bare KEY=VALUE lines only — this is consumed by `kubectl create secret
# --from-env-file`, NOT by a shell. Do not use `export`, and do not wrap values
# in quotes (the quotes would become part of the value). Blank lines and
# #-comments are ignored. Keys must be valid environment variable names.
#
# CALLBACK URLs MUST MATCH THE CLUSTER
#
# TMI_OAUTH_CALLBACK_URL is the redirect_uri the server hands to the IdP, and it
# must be registered verbatim as an authorized redirect URI in each provider's
# console (Google Cloud Console, GitHub OAuth App settings, Entra app
# registration). A value that is merely reachable is not enough — Google and
# Microsoft reject an unregistered redirect_uri outright. Point it at whichever
# hostname you actually browse to:
#
#   Traefik ingress   https://tmi.efitz.net/oauth2/callback
#   k3s NodePort      http://rp2:30080/oauth2/callback
#   docker-desktop    http://localhost:8080/oauth2/callback

TMI_SERVER_BASE_URL=https://tmi.efitz.net
TMI_OAUTH_CALLBACK_URL=https://tmi.efitz.net/oauth2/callback

# The bootstrap administrator, matched against the authenticated identity.
# TMI_ADMIN_PROVIDER_ID is the provider's subject claim for that user, not an
# email address (except where the provider's subject *is* the email).
TMI_ADMIN_PROVIDER=google
TMI_ADMIN_PROVIDER_ID=REPLACE_ME

# ---- Google -----------------------------------------------------------------
OAUTH_PROVIDERS_GOOGLE_ENABLED=true
OAUTH_PROVIDERS_GOOGLE_NAME=Google
OAUTH_PROVIDERS_GOOGLE_ICON=google
OAUTH_PROVIDERS_GOOGLE_CLIENT_ID=REPLACE_ME
OAUTH_PROVIDERS_GOOGLE_CLIENT_SECRET=REPLACE_ME
OAUTH_PROVIDERS_GOOGLE_ISSUER=https://accounts.google.com
OAUTH_PROVIDERS_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_PROVIDERS_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_PROVIDERS_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_PROVIDERS_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OAUTH_PROVIDERS_GOOGLE_SCOPES=openid,profile,email

# ---- GitHub -----------------------------------------------------------------
# GitHub is not OIDC: it has no issuer/JWKS, its userinfo response nests nothing
# useful for email, and the primary email comes from a second call to
# /user/emails. Hence the SECONDARY_* keys and the explicit claim mapping —
# without SUBJECT_CLAIM the server hits the #288 empty-user_id backstop.
OAUTH_PROVIDERS_GITHUB_ENABLED=true
OAUTH_PROVIDERS_GITHUB_NAME=GitHub
OAUTH_PROVIDERS_GITHUB_ICON=github
OAUTH_PROVIDERS_GITHUB_CLIENT_ID=REPLACE_ME
OAUTH_PROVIDERS_GITHUB_CLIENT_SECRET=REPLACE_ME
OAUTH_PROVIDERS_GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
OAUTH_PROVIDERS_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_PROVIDERS_GITHUB_USERINFO_URL=https://api.github.com/user
OAUTH_PROVIDERS_GITHUB_USERINFO_SECONDARY_URL=https://api.github.com/user/emails
OAUTH_PROVIDERS_GITHUB_USERINFO_SECONDARY_CLAIMS_EMAIL_CLAIM=email
OAUTH_PROVIDERS_GITHUB_USERINFO_SECONDARY_CLAIMS_EMAIL_VERIFIED_CLAIM=verified
OAUTH_PROVIDERS_GITHUB_USERINFO_CLAIMS_SUBJECT_CLAIM=id
OAUTH_PROVIDERS_GITHUB_USERINFO_CLAIMS_NAME_CLAIM=name
OAUTH_PROVIDERS_GITHUB_USERINFO_CLAIMS_PICTURE_CLAIM=avatar_url
OAUTH_PROVIDERS_GITHUB_ACCEPT_HEADER=application/vnd.github+json
OAUTH_PROVIDERS_GITHUB_AUTH_HEADER_FORMAT=Bearer %s
OAUTH_PROVIDERS_GITHUB_SCOPES=read:user,user:email

# ---- Microsoft --------------------------------------------------------------
# The "common" tenant accepts both work/school and personal accounts. For a
# single-tenant app registration, replace `common` with the tenant GUID in the
# authorization, token and issuer URLs.
OAUTH_PROVIDERS_MICROSOFT_ENABLED=true
OAUTH_PROVIDERS_MICROSOFT_NAME=Microsoft
OAUTH_PROVIDERS_MICROSOFT_ICON=microsoft
OAUTH_PROVIDERS_MICROSOFT_CLIENT_ID=REPLACE_ME
OAUTH_PROVIDERS_MICROSOFT_CLIENT_SECRET=REPLACE_ME
OAUTH_PROVIDERS_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
OAUTH_PROVIDERS_MICROSOFT_AUTHORIZATION_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
OAUTH_PROVIDERS_MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
OAUTH_PROVIDERS_MICROSOFT_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
OAUTH_PROVIDERS_MICROSOFT_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys
OAUTH_PROVIDERS_MICROSOFT_SCOPES=openid,profile,email,User.Read
OAUTH_PROVIDERS_MICROSOFT_USERINFO_CLAIMS_SUBJECT_CLAIM=sub
OAUTH_PROVIDERS_MICROSOFT_USERINFO_CLAIMS_EMAIL_CLAIM=email
OAUTH_PROVIDERS_MICROSOFT_USERINFO_CLAIMS_NAME_CLAIM=name
OAUTH_PROVIDERS_MICROSOFT_USERINFO_CLAIMS_GIVEN_NAME_CLAIM=given_name
OAUTH_PROVIDERS_MICROSOFT_USERINFO_CLAIMS_FAMILY_NAME_CLAIM=family_name

# ---- SAML (optional) --------------------------------------------------------
# Leave TMI_SAML_ENABLED=false and drop the block entirely unless you actually
# have an IdP to point at. SP_CERTIFICATE / SP_PRIVATE_KEY are PEM blobs; an env
# file cannot hold a multi-line value, so supply them with embedded \n escapes
# or patch those two keys into the Secret separately.
TMI_SAML_ENABLED=false
