#!/bin/bash
# pre-commit hook - lightweight static analysis on staged Go files.
#
# Runs gofmt, go vet, and golangci-lint --fast-only on the packages of the
# staged Go files, and blocks the commit on any failure.
#
# Bypass with: git commit --no-verify
set -uo pipefail

# Staged Go files (Added/Copied/Modified), excluding deletions. Git runs hooks
# with the working directory at the repository root, so paths are repo-relative.
staged_go=$(git diff --cached --diff-filter=ACM --name-only -- '*.go')

if [ -z "$staged_go" ]; then
    # Nothing Go-related staged (docs/config commit) -> no-op.
    exit 0
fi

fail=0

# 1. gofmt: list any staged file that is not gofmt-clean.
unformatted=$(gofmt -l $staged_go)
if [ -n "$unformatted" ]; then
    echo "pre-commit: the following staged files are not gofmt-formatted:" >&2
    echo "$unformatted" | sed 's/^/  /' >&2
    echo "  fix with: gofmt -w <files>" >&2
    fail=1
fi

# Unique package directories of the staged files, as ./dir patterns.
#
# Nested Go modules (e.g. test/integration, which has its own go.mod) are
# excluded: `go vet ./test/integration/...` run from the root module fails with
# "main module does not contain package ...", so staging any file from one of
# them would block the commit unconditionally. gofmt above still covers them,
# and their own module's build/test gates cover the rest.
root_mod=$(git rev-parse --show-toplevel)
in_nested_module() {
    local dir=$1
    while [ "$dir" != "$root_mod" ] && [ "$dir" != "/" ]; do
        [ -f "$dir/go.mod" ] && return 0
        dir=$(dirname "$dir")
    done
    return 1
}

pkg_dirs=""
skipped_dirs=""
for d in $(echo "$staged_go" | xargs -n1 dirname | sort -u); do
    if in_nested_module "$root_mod/$d"; then
        skipped_dirs="$skipped_dirs $d"
    else
        pkg_dirs="$pkg_dirs ./$d"
    fi
done

if [ -n "$skipped_dirs" ]; then
    echo "pre-commit: skipping vet/lint for nested-module packages:$skipped_dirs" >&2
fi

if [ -z "$pkg_dirs" ]; then
    # Everything staged lives in nested modules; gofmt already ran.
    [ "$fail" -ne 0 ] && exit 1
    exit 0
fi

# 2. go vet on just the affected packages (fast; whole-module vet is slow).
#
# Some scripts/ diagnostic/repair utilities (e.g. oracle-clob-like-probe,
# oracle-quota-default-fix) are single-file packages gated entirely by
# `//go:build oracle` so they can depend on godror without forcing CGO on
# every build. A tagless `go vet` sees zero buildable files in those specific
# directories and fails with "build constraints exclude all Go files" even
# though the file itself is fine.
#
# The fix is scoped, not global: packages like api/ also contain
# oracle-tagged files (e.g. *_oracle_test.go) alongside untagged ones, and
# blanket `-tags oracle` there would pull godror/cgo into every commit that
# touches api/, which most contributors' machines cannot build (no Oracle
# Instant Client). So each staged package directory is tested with a tagless
# `go list` first; only directories where that fails specifically on a build
# constraint (i.e. every buildable file in the directory requires the oracle
# tag) get a second, oracle-tagged vet/lint pass. Directories with a mix of
# tagged and untagged files are vetted exactly as before — tagless — so the
# oracle-tagged files there are silently skipped, same as a normal build.
normal_dirs=""
oracle_only_dirs=""
for d in $pkg_dirs; do
    list_err=$(mktemp)
    if go list "$d" >/dev/null 2>"$list_err"; then
        normal_dirs="$normal_dirs $d"
    elif grep -q "build constraints exclude all Go files" "$list_err"; then
        oracle_only_dirs="$oracle_only_dirs $d"
    else
        # Some other go list failure (e.g. a syntax error) — let the normal
        # tagless vet pass surface it as it would have before this change.
        normal_dirs="$normal_dirs $d"
    fi
    rm -f "$list_err"
done

if [ -n "$normal_dirs" ] && ! go vet $normal_dirs; then
    echo "pre-commit: go vet reported problems (see above)." >&2
    fail=1
fi
if [ -n "$oracle_only_dirs" ] && ! go vet -tags oracle $oracle_only_dirs; then
    echo "pre-commit: go vet -tags oracle reported problems (see above) for:$oracle_only_dirs" >&2
    fail=1
fi

# 3. golangci-lint --fast-only on the affected packages (honors .golangci.yml).
if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "pre-commit: golangci-lint is not installed." >&2
    echo "  install: https://golangci-lint.run/welcome/install/ (or: brew install golangci-lint)" >&2
    fail=1
else
    if [ -n "$normal_dirs" ] && ! golangci-lint run --fast-only $normal_dirs; then
        echo "pre-commit: golangci-lint reported problems (see above)." >&2
        fail=1
    fi
    if [ -n "$oracle_only_dirs" ] && ! golangci-lint run --fast-only --build-tags oracle $oracle_only_dirs; then
        echo "pre-commit: golangci-lint --build-tags oracle reported problems (see above) for:$oracle_only_dirs" >&2
        fail=1
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "pre-commit: checks failed; commit aborted (bypass with 'git commit --no-verify')." >&2
    exit 1
fi

exit 0
